FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# uv (pinned) — copied from the official image instead of pip-installing it.
COPY --from=ghcr.io/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 /uv /uvx /bin/

WORKDIR /app

# Install system dependencies including CA certificates, gosu, and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY pyproject.toml /workspace/pyproject.toml
COPY uv.lock /workspace/uv.lock
COPY README.md /workspace/README.md
COPY src /workspace/src
COPY packages/fastapi-identity-model /workspace/packages/fastapi-identity-model
COPY examples/fastapi /workspace/examples/fastapi

# Set workspace root
WORKDIR /workspace

# Install dependencies using workspace and add testing packages
RUN uv sync --all-packages && \
    uv pip install requests urllib3

# Switch to example directory
WORKDIR /workspace/examples/fastapi

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /workspace

# Copy entrypoint script
COPY examples/fastapi/entrypoint-test.sh /entrypoint-test.sh
RUN chmod +x /entrypoint-test.sh

# Entrypoint starts as root for CA certificate installation, then drops to appuser
CMD ["/entrypoint-test.sh"]
