{
  "description": "CFG-107: boolean parsing accepts true/false/1/0 case-insensitively; anything else is CFG-003",
  "mode": "strict",
  "group": null,
  "cases": [
    { "raw": "TRUE", "expect": { "config": { "test.require_https": true } } },
    { "raw": "false", "expect": { "config": { "test.require_https": false } } },
    { "raw": "1", "expect": { "config": { "test.require_https": true } } },
    { "raw": "0", "expect": { "config": { "test.require_https": false } } },
    { "raw": "yes", "expect": { "error": { "code": "CFG-003", "keys": ["test.require_https"] } } }
  ],
  "note": "Each case supplies TEST_REQUIRE_HTTPS=<raw> via an env source and constructs in strict mode."
}
