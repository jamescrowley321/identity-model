{
  "description": "CFG-402: any serialization the Config type offers redacts secrets",
  "mode": "strict",
  "group": "client",
  "client_auth_method": "client_secret_basic",
  "sources": [
    {
      "name": "env",
      "type": "env",
      "values": {
        "OIDC_DISCOVERY_URL": "https://issuer.example.com/.well-known/openid-configuration",
        "OIDC_CLIENT_ID": "confidential-client",
        "OIDC_CLIENT_SECRET": "s3cr3t-sentinel-VALUE"
      }
    }
  ],
  "expect": {
    "rendered_includes": ["<redacted>"],
    "rendered_excludes": ["s3cr3t-sentinel-VALUE"],
    "note": "e.g. serde/JSON serialization; the secret field serializes as the placeholder, never the raw value."
  }
}
