{
  "capability": "discovery",
  "spec": "OpenID Connect Discovery 1.0",
  "spec_url": "https://openid.net/specs/openid-connect-discovery-1_0.html",
  "required_fields": [
    "issuer",
    "authorization_endpoint",
    "token_endpoint",
    "jwks_uri",
    "response_types_supported",
    "subject_types_supported",
    "id_token_signing_alg_values_supported"
  ],
  "tests": [
    {
      "id": "DISC-001",
      "title": "Fetch and parse valid discovery document",
      "given": "A reachable issuer with a valid .well-known/openid-configuration",
      "when": "Discovery is invoked",
      "then": "Returned metadata contains all required fields with correct types",
      "references": [
        "\u00a73",
        "\u00a74.1",
        "\u00a74.2"
      ],
      "vectors": [
        {
          "name": "valid-document",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "authorization_endpoint": "https://server.example.com/auth",
              "token_endpoint": "https://server.example.com/token",
              "jwks_uri": "https://server.example.com/jwks",
              "response_types_supported": [
                "code",
                "id_token",
                "code id_token"
              ],
              "subject_types_supported": [
                "public"
              ],
              "id_token_signing_alg_values_supported": [
                "RS256",
                "ES256"
              ],
              "userinfo_endpoint": "https://server.example.com/userinfo",
              "scopes_supported": [
                "openid",
                "profile",
                "email",
                "offline_access"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "DISC-002",
      "title": "Validate all required fields present",
      "given": "A discovery document missing zero required fields",
      "when": "Field validation runs",
      "then": "Validation passes and all seven required fields are accessible",
      "references": [
        "\u00a73"
      ],
      "vectors": [
        {
          "name": "all-required-fields",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "authorization_endpoint": "https://server.example.com/auth",
              "token_endpoint": "https://server.example.com/token",
              "jwks_uri": "https://server.example.com/jwks",
              "response_types_supported": [
                "code",
                "id_token",
                "code id_token"
              ],
              "subject_types_supported": [
                "public"
              ],
              "id_token_signing_alg_values_supported": [
                "RS256",
                "ES256"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "DISC-003",
      "title": "Detect issuer mismatch",
      "given": "A discovery document whose issuer differs from the requested issuer",
      "when": "Discovery is invoked",
      "then": "An issuer-mismatch error is raised",
      "references": [
        "\u00a74.3"
      ],
      "vectors": [
        {
          "name": "issuer-mismatch",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/issuer-mismatch.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "issuer_mismatch"
          }
        }
      ]
    },
    {
      "id": "DISC-004",
      "title": "Cache hit on second fetch within TTL",
      "given": "A successful discovery fetch",
      "when": "Discovery is invoked again before the TTL expires",
      "then": "No HTTP request is made and the cached document is returned",
      "references": [
        "\u00a74"
      ],
      "vectors": [
        {
          "name": "second-call-within-ttl",
          "input": {
            "cache_ttl_seconds": 60,
            "calls_at_seconds": [
              0,
              30
            ]
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_calls": {
            "/.well-known/openid-configuration": 1
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "DISC-005",
      "title": "Cache miss after TTL expiry",
      "given": "A cached discovery document whose TTL has expired",
      "when": "Discovery is invoked",
      "then": "A new HTTP request is made and the cache is refreshed",
      "references": [
        "\u00a74"
      ],
      "vectors": [
        {
          "name": "call-after-ttl-expiry",
          "input": {
            "cache_ttl_seconds": 60,
            "calls_at_seconds": [
              0,
              120
            ]
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_calls": {
            "/.well-known/openid-configuration": 2
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "DISC-006",
      "title": "Handle HTTP error (404, 500)",
      "given": "An issuer whose discovery endpoint returns HTTP 404 or 500",
      "when": "Discovery is invoked",
      "then": "A transport/HTTP error is raised with the status code",
      "references": [
        "\u00a74.2"
      ],
      "vectors": [
        {
          "name": "not-found",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 404
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "unexpected_status",
            "status": 404
          }
        },
        {
          "name": "server-error",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 500
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "unexpected_status",
            "status": 500
          }
        }
      ]
    },
    {
      "id": "DISC-007",
      "title": "Handle invalid JSON response",
      "given": "An issuer whose discovery endpoint returns a non-JSON body, or a JSON value that is not an object",
      "when": "Discovery is invoked",
      "then": "A parse/deserialization error is raised",
      "references": [
        "\u00a74.2"
      ],
      "vectors": [
        {
          "name": "non-json-body",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/not-json.txt"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_json"
          }
        },
        {
          "name": "json-array-body",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/array-body.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_json"
          }
        },
        {
          "name": "json-null-body",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/null-body.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_json"
          }
        }
      ]
    },
    {
      "id": "DISC-008",
      "title": "Handle missing required field",
      "given": "A discovery document that omits one or more required fields, or leaves one empty",
      "when": "Field validation runs",
      "then": "A validation error is raised identifying the missing field(s)",
      "references": [
        "\u00a73"
      ],
      "vectors": [
        {
          "name": "missing-jwks-uri",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/missing-jwks-uri.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_fields",
            "fields": [
              "jwks_uri"
            ]
          }
        },
        {
          "name": "missing-multiple-fields",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/missing-multiple-fields.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_fields",
            "fields": [
              "token_endpoint",
              "subject_types_supported"
            ]
          }
        },
        {
          "name": "empty-required-arrays",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/empty-required-arrays.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_fields",
            "fields": [
              "response_types_supported",
              "subject_types_supported",
              "id_token_signing_alg_values_supported"
            ]
          }
        },
        {
          "name": "null-and-empty-string-required-fields",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/null-and-empty-string-required-fields.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_fields",
            "fields": [
              "authorization_endpoint",
              "token_endpoint",
              "subject_types_supported"
            ]
          }
        }
      ]
    },
    {
      "id": "DISC-009",
      "title": "Ignore unknown fields in discovery document",
      "given": "A discovery document containing extra fields not defined in the spec",
      "when": "Discovery is invoked",
      "then": "Extra fields are ignored (not rejected) and required fields remain accessible",
      "references": [
        "\u00a73"
      ],
      "vectors": [
        {
          "name": "unknown-field-ignored",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "token_endpoint": "https://server.example.com/token",
              "jwks_uri": "https://server.example.com/jwks"
            }
          }
        }
      ]
    },
    {
      "id": "DISC-010",
      "title": "Require HTTPS issuer URL",
      "given": "An issuer URL using http:// (not HTTPS)",
      "when": "Discovery is invoked in production mode",
      "then": "An error is raised indicating HTTPS is required (configurable for development)",
      "references": [
        "\u00a73"
      ],
      "vectors": [
        {
          "name": "http-issuer-rejected",
          "input": {
            "require_https": true
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_calls": {
            "/.well-known/openid-configuration": 0
          },
          "expect": {
            "outcome": "reject",
            "error": "https_required"
          }
        }
      ]
    },
    {
      "id": "DISC-011",
      "title": "Issuer match is exact",
      "given": "A discovery document whose issuer differs from the configured issuer only by a trailing slash, or equals it exactly",
      "when": "Discovery is invoked",
      "then": "Only an identical issuer is accepted; a terminating / on the configured issuer is removed when building the URL",
      "references": [
        "\u00a74.1",
        "\u00a74.3",
        "\u00a75"
      ],
      "vectors": [
        {
          "name": "exact-match",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "jwks_uri": "https://server.example.com/jwks"
            }
          }
        },
        {
          "name": "returned-trailing-slash",
          "input": {},
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/issuer-trailing-slash.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "reject",
            "error": "issuer_mismatch"
          }
        },
        {
          "name": "configured-trailing-slash",
          "input": {
            "issuer_suffix": "/"
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "reject",
            "error": "issuer_mismatch"
          }
        },
        {
          "name": "exact-match-trailing-slash",
          "input": {
            "issuer_suffix": "/"
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/issuer-trailing-slash.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com/",
              "jwks_uri": "https://server.example.com/jwks"
            }
          }
        }
      ]
    },
    {
      "id": "DISC-012",
      "title": "OpenID Connect location for an issuer with a path",
      "given": "An issuer with a path component",
      "when": "Discovery is invoked with the default location",
      "then": "The well-known path is appended to the issuer's path and the document is accepted",
      "references": [
        "\u00a74.1"
      ],
      "vectors": [
        {
          "name": "issuer-with-path",
          "input": {
            "location": "openid_configuration"
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/openid-configuration",
            "method": "GET"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "jwks_uri": "https://server.example.com/jwks"
            }
          }
        }
      ]
    },
    {
      "id": "DISC-013",
      "title": "RFC 8414 location for an issuer with a path",
      "given": "An issuer with a path component",
      "when": "Discovery is invoked with the RFC 8414 oauth-authorization-server location",
      "then": "The well-known path is inserted between the host and the issuer's path, and the returned issuer must be identical",
      "references": [
        "RFC 8414 \u00a73.1",
        "RFC 8414 \u00a73.3"
      ],
      "vectors": [
        {
          "name": "issuer-with-path",
          "input": {
            "location": "oauth_authorization_server"
          },
          "http": {
            "/.well-known/oauth-authorization-server": {
              "status": 200,
              "body_fixture": "discovery/valid.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/oauth-authorization-server",
            "method": "GET"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "issuer": "https://server.example.com",
              "jwks_uri": "https://server.example.com/jwks"
            }
          }
        },
        {
          "name": "returned-trailing-slash",
          "input": {
            "location": "oauth_authorization_server"
          },
          "http": {
            "/.well-known/oauth-authorization-server": {
              "status": 200,
              "body_fixture": "discovery/issuer-trailing-slash.json"
            }
          },
          "expect_request": {
            "path": "/.well-known/oauth-authorization-server",
            "method": "GET"
          },
          "expect": {
            "outcome": "reject",
            "error": "issuer_mismatch"
          }
        }
      ]
    }
  ],
  "notes": "HTTP vectors (see spec/README.md). The issuer is the vector's base URL on the mock server, which has a path, so every document is served at /.well-known/openid-configuration under it. `input.issuer_suffix` (e.g. \"/\") is appended to the base URL to form the configured issuer; the issuer match is exact, so a trailing-slash-only difference is issuer_mismatch. `input.location` selects where the document is fetched: `openid_configuration` (the default, OIDC Discovery \u00a74.1) or `oauth_authorization_server` (RFC 8414 \u00a73.1, the well-known segment inserted between the host and the base URL's path). Runners allow http:// issuers (their mock servers are plain HTTP) except where `input.require_https` is true, which calls with the default HTTPS requirement. `input.cache_ttl_seconds` sets the cache TTL and `input.calls_at_seconds` makes one call at each offset from the first; a runner without an injectable clock may map one second to a fixed wall-clock unit. `expect_calls` is the number of requests the server receives per path across all calls. An accept's `result` lists metadata fields compared by exact equality. Reject `error` codes: issuer_mismatch, unexpected_status (with `status`), invalid_json, missing_fields (with `fields`, in required_fields order), https_required. A required string field that is null or \"\", or a required array field that is null or [], counts as missing. A required field of the wrong JSON type (e.g. jwks_uri: []) is unspecified (#890)."
}
