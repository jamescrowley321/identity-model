{
  "capability": "authorization-code",
  "spec": "RFC 6749 §4.1 (Authorization Code Grant), RFC 7636 (PKCE)",
  "spec_url": "https://www.rfc-editor.org/rfc/rfc6749#section-4.1",
  "tests": [
    {
      "id": "ACG-001",
      "title": "Authorization code grant returns a typed token response",
      "given": "An authorization code, client ID and redirect URI",
      "when": "AuthorizationCode is called",
      "then": "A grant_type=authorization_code form POST carrying code and redirect_uri is sent and a typed TokenResponse is returned",
      "references": [
        "RFC 6749 §4.1.3"
      ],
      "vectors": [
        {
          "name": "public-client",
          "input": {
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "authorization-code/code-exchange-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "authorization_code",
              "code": "SplxlOBeZQQYbYS6WxSbIA",
              "redirect_uri": "https://client.example.org/cb",
              "client_id": "cid",
              "code_verifier": ""
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "access_token": "eyJhbGciOiJFUzI1NiIsImtpZCI6IjllciJ9.authorization-code.tok",
              "token_type": "Bearer",
              "expires_in": 3600,
              "refresh_token": "8xLOxBtZp8.refresh.tok",
              "scope": "openid profile"
            }
          }
        },
        {
          "name": "confidential-client-basic",
          "input": {
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb",
            "client_secret": "secret"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "authorization-code/code-exchange-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "authorization_code",
              "code": "SplxlOBeZQQYbYS6WxSbIA",
              "redirect_uri": "https://client.example.org/cb",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "access_token": "eyJhbGciOiJFUzI1NiIsImtpZCI6IjllciJ9.authorization-code.tok",
              "token_type": "Bearer",
              "expires_in": 3600,
              "refresh_token": "8xLOxBtZp8.refresh.tok",
              "scope": "openid profile"
            }
          }
        }
      ]
    },
    {
      "id": "ACG-002",
      "title": "GenerateCodeVerifier produces a 43-128 char unreserved string",
      "given": "A request for a PKCE code verifier",
      "when": "GenerateCodeVerifier is called",
      "then": "A cryptographically random verifier of 43-128 characters drawn only from the unreserved set [A-Za-z0-9-._~] is returned, and distinct_samples verifiers generated in a row are all different",
      "references": [
        "RFC 7636 §4.1"
      ],
      "vectors": [
        {
          "name": "generated",
          "input": {
            "operation": "generate_code_verifier"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "min_length": 43,
              "max_length": 128,
              "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~",
              "distinct_samples": 8
            }
          }
        }
      ]
    },
    {
      "id": "ACG-003",
      "title": "S256Challenge equals BASE64URL(SHA256(verifier))",
      "given": "The RFC 7636 Appendix B code verifier",
      "when": "S256Challenge is called",
      "then": "The result exactly matches the Appendix B expected challenge E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
      "references": [
        "RFC 7636 §4.2",
        "RFC 7636 Appendix B"
      ],
      "vectors": [
        {
          "name": "rfc7636-appendix-b",
          "input": {
            "operation": "s256_challenge",
            "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "code_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
            }
          }
        }
      ]
    },
    {
      "id": "ACG-004",
      "title": "WithCodeVerifier sends the code_verifier parameter",
      "given": "WithCodeVerifier(verifier) on an authorization code exchange",
      "when": "AuthorizationCode is called",
      "then": "The request body carries the code_verifier form parameter",
      "references": [
        "RFC 7636 §4.5"
      ],
      "vectors": [
        {
          "name": "code-verifier",
          "input": {
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb",
            "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "authorization-code/code-exchange-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "authorization_code",
              "code": "SplxlOBeZQQYbYS6WxSbIA",
              "redirect_uri": "https://client.example.org/cb",
              "client_id": "cid",
              "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "access_token": "eyJhbGciOiJFUzI1NiIsImtpZCI6IjllciJ9.authorization-code.tok",
              "token_type": "Bearer",
              "expires_in": 3600,
              "refresh_token": "8xLOxBtZp8.refresh.tok",
              "scope": "openid profile"
            }
          }
        }
      ]
    },
    {
      "id": "ACG-005",
      "title": "Authorization code error response is parsed into a typed TokenError",
      "given": "A token endpoint that rejects the code with an OAuth error body",
      "when": "AuthorizationCode is called",
      "then": "A typed TokenError carrying error/error_description/error_uri is returned (shared error path)",
      "references": [
        "RFC 6749 §5.2"
      ],
      "vectors": [
        {
          "name": "invalid-grant",
          "input": {
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb",
            "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
          },
          "http": {
            "/token": {
              "status": 400,
              "body_fixture": "authorization-code/code-exchange-error-invalid-grant.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "authorization_code",
              "code": "SplxlOBeZQQYbYS6WxSbIA",
              "redirect_uri": "https://client.example.org/cb",
              "client_id": "cid",
              "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_grant",
            "status": 400,
            "error_description": "authorization code is invalid, expired or already used",
            "error_uri": "https://docs.example.org/oauth/errors#invalid_grant"
          }
        }
      ]
    }
  ]
}
