{
  "capability": "client-credentials",
  "spec": "RFC 6749 §4.4 (Client Credentials Grant), §2.3 (Client Authentication), §5.1–5.2 (Token Response)",
  "spec_url": "https://www.rfc-editor.org/rfc/rfc6749#section-4.4",
  "tests": [
    {
      "id": "CC-001",
      "title": "Client credentials grant returns a typed token response",
      "given": "A client ID and client secret for a provider token endpoint",
      "when": "ClientCredentials is called",
      "then": "A grant_type=client_credentials form POST is sent and a typed TokenResponse carrying access_token, token_type, expires_in and optional scope is returned",
      "references": [
        "RFC 6749 §4.4",
        "RFC 6749 §5.1"
      ],
      "vectors": [
        {
          "name": "typed-token-response",
          "input": {},
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "access_token": "2YotnFZFEjr1zCsicMWpAA",
              "token_type": "Bearer",
              "expires_in": 3600,
              "scope": "api"
            }
          }
        }
      ]
    },
    {
      "id": "CC-002",
      "title": "client_secret_basic is the default authentication method",
      "given": "A client ID and secret with no explicit auth method",
      "when": "ClientCredentials is called",
      "then": "The request carries an HTTP Basic Authorization header whose username and password are the form-urlencoded client_id and client_secret, and no client credentials appear in the body",
      "references": [
        "RFC 6749 §2.3.1"
      ],
      "vectors": [
        {
          "name": "client-secret-basic",
          "input": {},
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "client-secret-basic-reserved-characters",
          "input": {
            "client_secret": "s:e@cret"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnMlM0FlJTQwY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "CC-003",
      "title": "client_secret_post places credentials in the form body",
      "given": "WithClientAuth(ClientSecretPost)",
      "when": "ClientCredentials is called",
      "then": "client_id and client_secret are sent as form parameters and no Basic Authorization header is set",
      "references": [
        "RFC 6749 §2.3.1"
      ],
      "vectors": [
        {
          "name": "client-secret-post",
          "input": {
            "client_auth": "client_secret_post"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials",
              "client_id": "cid",
              "client_secret": "secret"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "CC-004",
      "title": "Error response is parsed into a typed TokenError",
      "given": "A token endpoint that replies with a non-2xx OAuth error body",
      "when": "ClientCredentials is called",
      "then": "A typed TokenError carrying error, error_description and error_uri (plus the HTTP status) is returned",
      "references": [
        "RFC 6749 §5.2"
      ],
      "vectors": [
        {
          "name": "invalid-client",
          "input": {},
          "http": {
            "/token": {
              "status": 401,
              "body_fixture": "token/error-invalid-client.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_client",
            "status": 401,
            "error_description": "client authentication failed",
            "error_uri": "https://docs.example.com/errors#invalid_client"
          }
        }
      ]
    },
    {
      "id": "CC-005",
      "title": "WithScopes sends a space-delimited scope parameter",
      "given": "WithScopes(\"a\", \"b\")",
      "when": "ClientCredentials is called",
      "then": "The request body carries scope=a b (single space delimited) per RFC 6749",
      "references": [
        "RFC 6749 §3.3"
      ],
      "vectors": [
        {
          "name": "space-delimited-scopes",
          "input": {
            "scopes": [
              "a",
              "b"
            ]
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials",
              "scope": "a b"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "CC-006",
      "title": "WithExtraParams and WithHTTPClient are applied to the request",
      "given": "WithExtraParams and a custom WithHTTPClient",
      "when": "ClientCredentials is called",
      "then": "The extra parameters appear in the form body and the supplied http.Client performs the request",
      "references": [
        "RFC 6749 §4.4"
      ],
      "vectors": [
        {
          "name": "extra-params",
          "input": {
            "extra_params": {
              "resource": "https://api.example.com"
            }
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "client_credentials",
              "resource": "https://api.example.com"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "custom-http-client",
          "input": {
            "http_client_headers": {
              "x-client-marker": "custom"
            }
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token/client-credentials-success.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded",
              "x-client-marker": "custom"
            },
            "form": {
              "grant_type": "client_credentials"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    }
  ],
  "notes": "HTTP vectors. Each vector gives the call `input` (`client_auth: client_secret_post` to switch from the default client_secret_basic, `client_secret` to override the default, `scopes` to request, `extra_params` to add to the form, and `http_client_headers`, default headers of a caller-supplied HTTP client that the request must carry), the canned `http` responses keyed by request path (`body_fixture` is relative to spec/test-fixtures/; the literal https://server.example.com in a fixture is replaced with the mock server's base URL), the request the client must send (`expect_request`), and the outcome (`expect`). Client credentials default to client_id=cid, client_secret=secret. An empty expected header or form value means it MUST be absent. An accept may carry `result` (typed token response fields, compared by exact equality). A reject carries the canonical OAuth `error` code, the HTTP `status`, and the `error_description` and `error_uri` of the typed token error."
}
