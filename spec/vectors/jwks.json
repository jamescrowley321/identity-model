    },
    {
      "id": "JWKS-003",
      "title": "Resolve key by kid",
      "given": "A cached JWK Set",
      "when": "resolve_key(kid) is called with a present kid",
      "then": "The matching key is returned",
      "references": [
        "RFC 7517 \u00a74.5"
      ],
      "vectors": [
        {
          "name": "resolve-cached-kid",
          "input": {
            "steps": [
              "fetch",
              "resolve"
            ],
            "kid": "ec-sig-key"
          },
          "http": {
            "/jwks": {
              "status": 200,
              "body_fixture": "jwks/valid.json"
            }
          },
          "expect_calls": {
            "/jwks": 1
          },
          "expect": {
            "outcome": "accept",
            "keys": [
              {
                "kty": "EC",
                "kid": "ec-sig-key",
                "use": "sig",
                "alg": "ES256",
                "crv": "P-256",
                "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
                "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "JWKS-004",
      "title": "Key-not-found triggers forced refresh then retry",
      "given": "A kid not present in the cached set",
      "when": "Key resolution is attempted",
      "then": "A forced refresh is performed and resolution retried before a key-not-found error; a second miss within the refresh cooldown fails without another fetch",
      "references": [
        "RFC 7517 \u00a75"
      ],
      "vectors": [
        {
          "name": "rotated-kid-found-after-refresh",
          "input": {
            "steps": [
              "fetch",
              "resolve"
            ],
            "kid": "ec-rotated-key"
          },
          "http_sequence": {
            "/jwks": [
              {
                "status": 200,
                "body_fixture": "jwks/valid.json"
              },
              {
                "status": 200,
                "body_fixture": "jwks/rotated.json"
              }
            ]
          },
          "expect_calls": {
            "/jwks": 2
          },
          "expect": {
            "outcome": "accept",
            "keys": [
              {
                "kty": "EC",
                "kid": "ec-rotated-key",
                "use": "sig",
                "alg": "ES256",
                "crv": "P-256",
                "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
                "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
              }
            ]
          }
        },
        {
          "name": "kid-absent-after-refresh",
          "input": {
            "steps": [
              "fetch",
              "resolve"
            ],
            "kid": "unknown-key"
          },
          "http": {
            "/jwks": {
              "status": 200,
              "body_fixture": "jwks/valid.json"
            }
          },
          "expect_calls": {
            "/jwks": 2
          },
          "expect": {
            "outcome": "reject",
            "error": "key_not_found"
          }
        },
        {
          "name": "refresh-cooldown-suppresses-second-miss",
          "input": {
            "steps": [
              "fetch",
              "resolve",
              "resolve"
            ],
            "kids": [
              "unknown-key-a",
              "unknown-key-b"
            ]
          },
          "http": {
            "/jwks": {
              "status": 200,
              "body_fixture": "jwks/valid.json"
            }
          },
          "expect_calls": {
            "/jwks": 2
          },
          "expect": {
            "outcome": "reject",
            "error": "key_not_found"
          }
        }
      ]
    },
    {
      "id": "JWKS-005",
      "title": "Cache hit within TTL",
      "given": "A successful JWKS fetch",
      "when": "The key set is requested again within the TTL",
