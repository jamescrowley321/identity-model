                "n": "0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw",
                "e": "AQAB"
              },
              {
                "kty": "EC",
                "kid": "ec-sig-key",
                "use": "sig",
                "alg": "ES256",
                "crv": "P-256",
                "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
                "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "JWKS-006",
      "title": "Force refresh on signature failure",
      "given": "A signature verification failure",
      "when": "force_refresh() is invoked",
      "then": "The cached set is invalidated and re-fetched from the provider",
      "references": [
        "RFC 7517 \u00a75"
      ],
      "vectors": [
        {
          "name": "force-refresh-refetches",
          "input": {
            "steps": [
              "fetch",
              "force_refresh"
            ]
          },
          "http_sequence": {
            "/jwks": [
              {
                "status": 200,
                "body_fixture": "jwks/valid.json"
              },
              {
                "status": 200,
                "body_fixture": "jwks/rotated.json"
              }
            ]
          },
          "expect_calls": {
            "/jwks": 2
          },
          "expect": {
            "outcome": "accept",
            "keys": [
              {
                "kty": "EC",
                "kid": "ec-rotated-key",
                "use": "sig",
                "alg": "ES256",
                "crv": "P-256",
                "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
                "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "JWKS-007",
      "title": "Handle malformed or empty JWKS",
      "given": "A jwks_uri returning invalid JSON or an empty key set",
      "when": "The key set is fetched",
      "then": "A descriptive deserialization/validation error is raised",
      "references": [
        "RFC 7517 \u00a75"
      ],
      "vectors": [
        {
          "name": "empty-key-set",
          "input": {
            "steps": [
              "fetch"
            ]
          },
          "http": {
            "/jwks": {
              "status": 200,
              "body_fixture": "jwks/empty.json"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "empty_key_set"
          }
        },
        {
          "name": "malformed-json",
          "input": {
            "steps": [
              "fetch"
            ]
          },
          "http": {
            "/jwks": {
              "status": 200,
              "body_fixture": "jwks/malformed.txt"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "malformed"
          }
        }
      ]
    }
  ],
  "notes": "HTTP vectors. The key set is served at /jwks. `input.steps` are the calls made in order against one client (`fetch` the key set, `resolve` `input.kid`, or the next of `input.kids` when given, with a forced refresh on a miss, `force_refresh` the set); the result is the last step's keys (a resolved key is a one-key list). A `key_not_found` from a `resolve` before the last step does not end the run; any other error does. Automatic refreshes on a miss are rate-limited per jwks_uri by a refresh cooldown (5s by default in every language). `http_sequence` serves the n-th listed response for the n-th request to a path (the last one repeats); `expect_calls` is the exact number of requests per path. `expect.keys` lists each key's non-empty kty/kid/use/alg/n/e/crv/x/y. A reject carries a canonical `error`: `malformed` (not a JWK Set document), `empty_key_set`, or `key_not_found`."
}
