    {
      "id": "EXCH-004",
      "title": "requested_token_type and audience parameters are included",
      "given": "requested_token_type=urn:ietf:params:oauth:token-type:access_token and audience=https://api.example.com alongside the subject token",
      "when": "TokenExchange is called with the requested token type and audience configured",
      "then": "Both parameters are sent in the request body; the issued_token_type in the response MAY differ from the requested_token_type",
      "references": [
        "RFC 8693 §2.1",
        "RFC 8693 §2.2"
      ],
      "vectors": [
        {
          "name": "requested-type-and-audience",
          "input": {
            "subject_token": "eyJhbGciOiJFUzI1NiJ9.subject.tok",
            "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
            "requested_token_type": "urn:ietf:params:oauth:token-type:access_token",
            "audience": "https://api.example.com",
            "scope": "https://api.example.com/read"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "token-exchange/exchange-n_a-token-type.json"
            }
