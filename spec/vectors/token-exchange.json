    {
      "id": "EXCH-006",
      "title": "Error response is surfaced as a typed OAuth error",
      "given": "An exchange request the server rejects (invalid subject_token, unauthorized client, or unsupported grant type)",
      "when": "The endpoint replies HTTP 400 with a standard OAuth error body (error=invalid_grant or error=invalid_request)",
      "then": "A typed token error carrying the error code plus optional error_description and error_uri (and the HTTP status) is surfaced",
      "references": [
        "RFC 8693 §2.2.2",
        "RFC 6749 §5.2"
      ],
      "vectors": [
        {
          "name": "invalid-grant",
          "input": {
            "subject_token": "eyJhbGciOiJFUzI1NiJ9.subject.tok",
            "subject_token_type": "urn:ietf:params:oauth:token-type:access_token"
          },
          "http": {
            "/token": {
              "status": 400,
              "body_fixture": "token-exchange/exchange-error-invalid-grant.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "eyJhbGciOiJFUzI1NiJ9.subject.tok",
              "subject_token_type": "urn:ietf:params:oauth:token-type:access_token"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_grant",
            "status": 400,
            "error_description": "subject_token is expired or otherwise invalid"
          }
        },
        {
          "name": "invalid-request",
          "input": {
            "subject_token": "eyJhbGciOiJFUzI1NiJ9.subject.tok",
            "subject_token_type": "urn:ietf:params:oauth:token-type:access_token"
