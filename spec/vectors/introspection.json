{
  "capability": "introspection",
  "spec": "RFC 7662 (OAuth 2.0 Token Introspection)",
  "spec_url": "https://www.rfc-editor.org/rfc/rfc7662",
  "required_fields": [
    "active"
  ],
  "tests": [
    {
      "id": "INTR-001",
      "title": "Successful introspection of an active token",
      "given": "A valid, non-expired token and authenticated client credentials for the introspection endpoint",
      "when": "Introspect is called with the token parameter",
      "then": "A POST application/x-www-form-urlencoded request carrying token is sent and a typed response with active=true plus standard metadata (scope, client_id, username, token_type, exp, iat, nbf, sub, aud, iss, jti) is returned; unknown members remain reachable. A 200 response whose REQUIRED active member is missing or not a boolean is rejected as malformed rather than read as inactive",
      "references": [
        "RFC 7662 §2.1",
        "RFC 7662 §2.2"
      ],
      "vectors": [
        {
          "name": "active-token",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-response.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept",
            "claims": {
              "active": true,
              "scope": "read write dolphin",
              "client_id": "l238j323ds-23ij4",
              "username": "jdoe",
              "token_type": "Bearer",
              "exp": 1419356238,
              "iat": 1419350238,
              "nbf": 1419350238,
              "sub": "Z5O3upPC88QrAjx00dis",
              "aud": [
                "https://protected.example.net/resource"
              ],
              "iss": "https://issuer.example.com/",
              "jti": "d3f5c9a1-2b7e-4c1a-9e8f-0a1b2c3d4e5f"
            },
            "custom_claims": {
              "extension_field": "twenty-seven"
            }
          }
        },
        {
          "name": "missing-active",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/missing-active.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST"
          },
          "expect": {
            "outcome": "reject",
            "error": "malformed",
            "status": 200
          }
        },
        {
          "name": "active-not-boolean",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-not-boolean.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST"
          },
          "expect": {
            "outcome": "reject",
            "error": "malformed",
            "status": 200
          }
        }
      ]
    },
    {
      "id": "INTR-002",
      "title": "Introspection of an inactive or expired token",
      "given": "An expired or revoked token and authenticated client credentials",
      "when": "Introspect is called with the token parameter",
      "then": "A typed response with active=false is returned and no other member is required to be present",
      "references": [
        "RFC 7662 §2.2"
      ],
      "vectors": [
        {
          "name": "inactive-token",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/inactive-response.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept",
            "claims": {
              "active": false
            }
          }
        }
      ]
    },
    {
      "id": "INTR-003",
      "title": "Client authentication on the introspection request",
      "given": "Valid client credentials",
      "when": "Introspect is called using client_secret_basic (default) and, separately, client_secret_post",
      "then": "With client_secret_basic the request carries an HTTP Basic Authorization header whose username and password are the form-urlencoded client_id and client_secret and no credentials appear in the body; with client_secret_post client_id and client_secret appear as form parameters and no Basic header is set",
      "references": [
        "RFC 7662 §2.1",
        "RFC 6749 §2.3.1"
      ],
      "vectors": [
        {
          "name": "client-secret-basic",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "client-secret-basic-reserved-characters",
          "input": {
            "token": "the-token",
            "client_secret": "s:e@cret"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnMlM0FlJTQwY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "client_id": "",
              "client_secret": ""
            }
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "client-secret-post",
          "input": {
            "token": "the-token",
            "client_auth": "client_secret_post"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "client_id": "cid",
              "client_secret": "secret"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "INTR-004",
      "title": "token_type_hint is included in the request",
      "given": "A token and a token_type_hint of access_token or refresh_token",
      "when": "Introspect is called with the hint configured",
      "then": "The hint is sent as the token_type_hint form parameter; the token parameter is always present and the request succeeds regardless of hint correctness",
      "references": [
        "RFC 7662 §2.1"
      ],
      "vectors": [
        {
          "name": "access-token-hint",
          "input": {
            "token": "the-token",
            "token_type_hint": "access_token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "token_type_hint": "access_token"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "refresh-token-hint",
          "input": {
            "token": "the-token",
            "token_type_hint": "refresh_token"
          },
          "http": {
            "/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token",
              "token_type_hint": "refresh_token"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "INTR-005",
      "title": "Error response from the introspection endpoint",
      "given": "Invalid client credentials",
      "when": "Introspect is called and the endpoint replies HTTP 401 with an OAuth error body",
      "then": "A typed introspection error carrying error=invalid_client (plus optional error_description, error_uri, and the HTTP status) is surfaced",
      "references": [
        "RFC 7662 §2.3",
        "RFC 6749 §5.2"
      ],
      "vectors": [
        {
          "name": "invalid-client",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/introspect": {
              "status": 401,
              "body_fixture": "introspection/error-invalid-client.json"
            }
          },
          "expect_request": {
            "path": "/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "invalid_client",
            "status": 401
          }
        }
      ]
    },
    {
      "id": "INTR-006",
      "title": "Discovery-based endpoint resolution",
      "given": "A valid OIDC Discovery / Authorization Server Metadata document containing introspection_endpoint",
      "when": "The introspection endpoint is resolved from discovery and passed to Introspect",
      "then": "The introspection_endpoint URL from the discovery document is used rather than requiring manual configuration",
      "references": [
        "RFC 8414 §2"
      ],
      "vectors": [
        {
          "name": "endpoint-from-discovery",
          "input": {
            "token": "the-token",
            "discover": true
          },
          "http": {
            "/.well-known/openid-configuration": {
              "status": 200,
              "body_fixture": "introspection/discovery-with-introspection.json"
            },
            "/oauth2/introspect": {
              "status": 200,
              "body_fixture": "introspection/active-minimal.json"
            }
          },
          "expect_request": {
            "path": "/oauth2/introspect",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "token": "the-token"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    }
  ],
  "notes": "HTTP vectors. Each vector gives the call `input` (`token`, optional `token_type_hint`, `client_auth: client_secret_post` to switch from the default client_secret_basic, `client_secret` to override the default, and `discover` to resolve the endpoint from discovery), the canned `http` responses keyed by request path (`body_fixture` is relative to spec/test-fixtures/; the literal https://server.example.com in a fixture is replaced with the mock server's base URL), the request the client must send (`expect_request`), and the outcome (`expect`). Client credentials default to client_id=cid, client_secret=secret. An empty expected header or form value means it MUST be absent. An accept may carry `claims` (standard §2.2 members, each of which MUST be a typed field with that value; `aud` is typed as a list) and `custom_claims` (non-standard members, each of which MUST be reachable in the response overflow map). A reject carries the canonical OAuth `error` code and HTTP `status`, or `error: malformed` (with the 2xx `status`) for a response that is not a valid §2.2 body, such as one whose REQUIRED `active` member is missing or not a boolean."
}
