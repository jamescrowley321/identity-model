{
  "capability": "validation",
  "spec": "RFC 7519 (JWT), RFC 7515 (JWS), OIDC Core 1.0 §3.1.3.7",
  "spec_url": "https://www.rfc-editor.org/rfc/rfc7519",
  "notes": "Vectors are language-neutral: `error` values are canonical codes (malformed, alg_none, unsupported_alg, signature, key_conversion, weak_key, claim_validation) that each language executor maps to its own error type. Time claims (exp/nbf/iat) are duration strings relative to options.now so minted tokens stay fresh. Expected outcomes follow the behaviour of the OIDF-certified py-identity-model reference. A vector with no `allowed_algorithms` runs under each library's default allowlist: RS256/384/512, PS256/384/512, ES256/384/512 and EdDSA (Rust omits ES512).",
  "tests": [
    {
      "id": "JWT-001",
      "title": "Verify signature with kid-resolved key",
      "given": "A signed JWT whose header kid matches a key in the key set",
      "when": "The token is validated",
      "then": "The JWS signature is verified against the resolved key and a typed claims set is returned",
      "references": ["RFC 7515 §4.1"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "accept", "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client"}}
        }
      ]
    },
    {
      "id": "JWT-002",
      "title": "Check registered claims",
      "given": "A signed JWT carrying iss/aud/exp/nbf/iat",
      "when": "The token is validated with the expected issuer and audience",
      "then": "iss matches exactly, aud contains the expected value, exp/nbf bound the validity window and iat is present",
      "references": ["RFC 7519 §4.1"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "expected_issuer": "https://issuer.example.com", "expected_audience": "test-client"},
          "expect": {"outcome": "accept", "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client"}}
        }
      ]
    },
    {
      "id": "JWT-003",
      "title": "Reject alg:none unconditionally",
      "given": "An unsigned JWT with header alg \"none\"",
      "when": "The token is validated",
      "then": "Validation is rejected before any signature step with an explicit alg-none error",
      "references": ["RFC 7519 §7.2"],
      "vectors": [
        {
          "token": {"static": "validation/alg-none-token.txt"},
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "alg_none"}
        }
      ]
    },
    {
      "id": "JWT-004",
      "title": "Validate nonce when expected",
      "given": "A signed JWT carrying a nonce claim",
      "when": "The token is validated with the expected nonce set",
      "then": "A nonce mismatch is rejected and a matching nonce passes",
      "references": ["OIDC Core 1.0 §3.1.3.7"],
      "vectors": [
        {
          "name": "matching nonce passes",
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "nonce": "n-abc123", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "expected_nonce": "n-abc123"},
          "expect": {"outcome": "accept", "claims": {"nonce": "n-abc123"}}
        },
        {
          "name": "nonce mismatch is rejected",
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "nonce": "n-abc123", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "expected_nonce": "n-different"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "nonce"}
        }
      ]
    },
    {
      "id": "JWT-005",
      "title": "Reject expired token",
      "given": "A signed JWT whose exp is in the past beyond the clock skew",
      "when": "The token is validated",
      "then": "Validation fails with an expiry error",
      "references": ["RFC 7519 §4.1.4"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "-1h", "nbf": "-2h", "iat": "-2h"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "exp"}
        }
      ]
    },
    {
      "id": "JWT-006",
      "title": "Reject not-yet-valid token",
      "given": "A signed JWT whose nbf is in the future beyond the clock skew",
      "when": "The token is validated",
      "then": "Validation fails with a not-before error",
      "references": ["RFC 7519 §4.1.5"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "2h", "nbf": "1h", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "nbf"}
        }
      ]
    },
    {
      "id": "JWT-007",
      "title": "Reject wrong issuer",
      "given": "A signed JWT whose iss differs from the expected issuer",
      "when": "The token is validated with the expected issuer set",
      "then": "Validation fails with an issuer-mismatch error",
      "references": ["RFC 7519 §4.1.1"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://attacker.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "expected_issuer": "https://issuer.example.com"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "iss"}
        }
      ]
    },
    {
      "id": "JWT-008",
      "title": "Reject wrong or absent audience",
      "given": "A signed JWT whose aud does not contain the expected audience",
      "when": "The token is validated with the expected audience set",
      "then": "Validation fails with an audience error",
      "references": ["RFC 7519 §4.1.3"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "some-other-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "expected_audience": "test-client"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "aud"}
        }
      ]
    },
    {
      "id": "JWT-009",
      "title": "Reject bad signature",
      "given": "A signed JWT whose signature does not verify against the resolved key",
      "when": "The token is validated",
      "then": "Validation fails with a signature error",
      "references": ["RFC 7515 §5.2"],
      "vectors": [
        {
          "token": {
            "signing_key": "ephemeral",
            "header_kid": "test-key-1",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "signature"}
        }
      ]
    },
    {
      "id": "JWT-011",
      "title": "Tolerate clock skew",
      "given": "A signed JWT whose exp is marginally in the past within the configured skew",
      "when": "The token is validated with a clock skew set",
      "then": "Validation succeeds because the skew tolerance covers the difference",
      "references": ["RFC 7519 §4.1.4"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "-30s", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "clock_skew": "60s"},
          "expect": {"outcome": "accept", "claims": {"iss": "https://issuer.example.com", "sub": "user-123"}}
        }
      ]
    },
    {
      "id": "JWT-012",
      "title": "Enforce custom required claims",
      "given": "A signed JWT missing a claim named in the required-claims option",
      "when": "The token is validated",
      "then": "Validation fails identifying the missing required claim",
      "references": ["RFC 7519 §4.1"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z", "required_claims": ["email"]},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "email"}
        }
      ]
    },
    {
      "id": "JWT-013",
      "title": "Reject token missing iat",
      "given": "A signed JWT without an iat claim",
      "when": "The token is validated",
      "then": "Validation fails because iat is required",
      "references": ["RFC 7519 §4.1.6"],
      "vectors": [
        {
          "token": {
            "signing_key": "fixture",
            "alg": "RS256",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "claim_validation", "claim": "iat"}
        }
      ]
    },
    {
      "id": "JWT-014",
      "title": "Reject a verification key below the minimum strength",
      "given": "A JWT whose kid resolves to an RSA key under 2048 bits or an EC key under 224 bits",
      "when": "The token is validated",
      "then": "Validation fails with a weak-key error before the signature is checked. RSA strength is the bit length of the modulus n; EC strength is 8 times the byte length of the x coordinate",
      "references": ["RFC 7518 §3.3", "RFC 7518 §6.2.1.2", "FAPI 2.0 Security Profile §5.4.1"],
      "vectors": [
        {
          "name": "rsa-1024-key-rejected",
          "token": {"static": "validation/weak-rsa-1024-token.txt"},
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "weak_key"}
        },
        {
          "name": "ec-p192-key-rejected",
          "token": {"static": "validation/weak-ec-p192-token.txt"},
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "reject", "error": "weak_key"}
        }
      ]
    },
    {
      "id": "JWT-015",
      "title": "Accept EdDSA under the default algorithm allowlist",
      "given": "A JWT signed with an Ed25519 key, validated without an explicit algorithm allowlist",
      "when": "The token is validated",
      "then": "The default allowlist includes EdDSA, so the signature is verified and the claims are returned",
      "references": ["RFC 8037 §3.1", "FAPI 2.0 Security Profile §5.4.1"],
      "vectors": [
        {
          "name": "ed25519-default-allowlist",
          "token": {
            "signing_key": "ed25519",
            "alg": "EdDSA",
            "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client", "exp": "1h", "nbf": "-1m", "iat": "-1m"}
          },
          "options": {"now": "2023-11-14T22:13:20Z"},
          "expect": {"outcome": "accept", "claims": {"iss": "https://issuer.example.com", "sub": "user-123", "aud": "test-client"}}
        }
      ]
    }
  ]
}
