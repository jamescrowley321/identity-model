{
  "capability": "userinfo",
  "spec": "OpenID Connect Core 1.0 §5.3 / §5.1",
  "spec_url": "https://openid.net/specs/openid-connect-core-1_0.html#UserInfo",
  "tests": [
    {
      "id": "UI-001",
      "title": "Fetch claims with Bearer authentication",
      "given": "A reachable userinfo_endpoint and a valid access token",
      "when": "Fetch is invoked with the access token",
      "then": "The request carries an Authorization: Bearer header and the typed standard §5.1 claims are returned",
      "references": [
        "§5.3",
        "§5.1",
        "§5.3.1"
      ],
      "vectors": [
        {
          "name": "standard-claims",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/standard-claims.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "accept",
            "claims": {
              "sub": "248289761001",
              "name": "Jane Doe",
              "given_name": "Jane",
              "family_name": "Doe",
              "middle_name": "Quinn",
              "nickname": "Janie",
              "preferred_username": "j.doe",
              "profile": "https://example.com/janedoe",
              "picture": "https://example.com/janedoe/me.jpg",
              "website": "https://blog.example.com/janedoe",
              "email": "janedoe@example.com",
              "email_verified": true,
              "gender": "female",
              "birthdate": "1972-03-31",
              "zoneinfo": "Europe/Paris",
              "locale": "en-US",
              "phone_number": "+1 (425) 555-1212",
              "phone_number_verified": false,
              "address": {
                "formatted": "1234 Hollywood Blvd.\nLos Angeles, CA 90210\nUSA",
                "street_address": "1234 Hollywood Blvd.",
                "locality": "Los Angeles",
                "region": "CA",
                "postal_code": "90210",
                "country": "USA"
              },
              "updated_at": 1700000000
            }
          }
        }
      ]
    },
    {
      "id": "UI-002",
      "title": "Subject consistency match passes",
      "given": "An expected subject equal to the UserInfo sub",
      "when": "Fetch is invoked with subject validation enabled",
      "then": "The response is returned without error",
      "references": [
        "§5.3.2"
      ],
      "vectors": [
        {
          "name": "subject-match",
          "input": {
            "token": "the-token",
            "expected_sub": "248289761001"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/standard-claims.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "accept"
          }
        }
      ]
    },
    {
      "id": "UI-003",
      "title": "Subject consistency mismatch or missing sub errors",
      "given": "An expected subject different from the UserInfo sub, or a UserInfo response with no sub",
      "when": "Fetch is invoked with subject validation enabled",
      "then": "A subject-mismatch error is raised; a response without sub is rejected whether or not an expected subject is supplied",
      "references": [
        "§5.3.2"
      ],
      "vectors": [
        {
          "name": "subject-mismatch",
          "input": {
            "token": "the-token",
            "expected_sub": "another-subject"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/standard-claims.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "subject_mismatch"
          }
        },
        {
          "name": "missing-sub-with-expected-sub",
          "input": {
            "token": "the-token",
            "expected_sub": "248289761001"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/missing-sub.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_sub"
          }
        },
        {
          "name": "missing-sub",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/missing-sub.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "error": "missing_sub"
          }
        }
      ]
    },
    {
      "id": "UI-004",
      "title": "Handle 401 with WWW-Authenticate challenge",
      "given": "A userinfo_endpoint that returns HTTP 401 with a WWW-Authenticate header",
      "when": "Fetch is invoked",
      "then": "A typed error carrying the status and the WWW-Authenticate challenge is raised",
      "references": [
        "§5.3.3",
        "RFC 6750 §3"
      ],
      "vectors": [
        {
          "name": "invalid-token-challenge",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 401,
              "headers": {
                "WWW-Authenticate": "Bearer error=\"invalid_token\", error_description=\"The access token expired\""
              }
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "status": 401,
            "www_authenticate": "Bearer error=\"invalid_token\", error_description=\"The access token expired\""
          }
        }
      ]
    },
    {
      "id": "UI-005",
      "title": "Handle 403 error response",
      "given": "A userinfo_endpoint that returns HTTP 403",
      "when": "Fetch is invoked",
      "then": "A typed error carrying the 403 status is raised",
      "references": [
        "§5.3.3",
        "RFC 6750 §3"
      ],
      "vectors": [
        {
          "name": "forbidden",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 403
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "status": 403
          }
        }
      ]
    },
    {
      "id": "UI-006",
      "title": "Handle 5xx / non-JSON response",
      "given": "A userinfo_endpoint that returns HTTP 500 with a non-JSON body",
      "when": "Fetch is invoked",
      "then": "A descriptive request error carrying the status is raised",
      "references": [
        "§5.3"
      ],
      "vectors": [
        {
          "name": "server-error-html",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 500,
              "headers": {
                "Content-Type": "text/html"
              },
              "body_fixture": "userinfo/server-error.html"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "reject",
            "status": 500
          }
        }
      ]
    },
    {
      "id": "UI-007",
      "title": "Preserve custom claims",
      "given": "A UserInfo response containing standard and non-standard claims",
      "when": "Fetch is invoked",
      "then": "Custom claims are accessible via the response claim map and standard claims remain typed",
      "references": [
        "§5.1",
        "§5.1.2"
      ],
      "vectors": [
        {
          "name": "custom-claims",
          "input": {
            "token": "the-token"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/standard-claims.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "Bearer the-token"
            }
          },
          "expect": {
            "outcome": "accept",
            "claims": {
              "sub": "248289761001",
              "name": "Jane Doe",
              "given_name": "Jane",
              "family_name": "Doe",
              "middle_name": "Quinn",
              "nickname": "Janie",
              "preferred_username": "j.doe",
              "profile": "https://example.com/janedoe",
              "picture": "https://example.com/janedoe/me.jpg",
              "website": "https://blog.example.com/janedoe",
              "email": "janedoe@example.com",
              "email_verified": true,
              "gender": "female",
              "birthdate": "1972-03-31",
              "zoneinfo": "Europe/Paris",
              "locale": "en-US",
              "phone_number": "+1 (425) 555-1212",
              "phone_number_verified": false,
              "address": {
                "formatted": "1234 Hollywood Blvd.\nLos Angeles, CA 90210\nUSA",
                "street_address": "1234 Hollywood Blvd.",
                "locality": "Los Angeles",
                "region": "CA",
                "postal_code": "90210",
                "country": "USA"
              },
              "updated_at": 1700000000
            },
            "custom_claims": {
              "department": "Engineering"
            }
          }
        }
      ]
    }
  ],
  "notes": "HTTP vectors. Each vector gives the call `input` (`token`, and `expected_sub` to enable subject validation), the canned `http` responses keyed by request path (`body_fixture` is relative to spec/test-fixtures/), the request the client must send (`expect_request`), and the outcome (`expect`). An accept may carry `claims` (standard §5.1 claims, each of which MUST be a typed field with that value) and `custom_claims` (non-standard claims, each of which MUST be reachable in the response claim map with that value). A reject carries `error: subject_mismatch`, `error: missing_sub` (a 200 response with no `sub` claim), or the HTTP `status` of the error response plus the `www_authenticate` challenge when the endpoint sent one. The custom HTTP client and timeout requirement is an API-shape contract, not data; see spec/capabilities.md."
}
