{
  "capability": "dpop",
  "spec": "RFC 9449 (OAuth 2.0 Demonstrating Proof of Possession) + RFC 7638 (JWK Thumbprint)",
  "spec_url": "https://www.rfc-editor.org/rfc/rfc9449",
  "required_fields": [
    "typ",
    "htm",
    "htu",
    "jti",
    "iat"
  ],
  "tests": [
    {
      "id": "DPOP-001",
      "title": "Generate a valid DPoP proof JWT",
      "given": "A DPoP key pair (ES256 or RS256), the HTTP method POST, and the request URI https://server.example.com/token",
      "when": "A DPoP proof JWT is generated for the request",
      "then": "The compact JWS has a protected header with typ=dpop+jwt, alg equal to the key pair's asymmetric algorithm (never a symmetric algorithm such as HS256), and a jwk member containing ONLY the public key (no private key material such as d, p, q); and a payload with a non-empty unique jti, htm=POST, htu=https://server.example.com/token, and a recent iat timestamp",
      "references": [
        "RFC 9449 §4.2",
        "RFC 7515 §4.1"
      ],
      "vectors": [
        {
          "name": "es256",
          "input": {
            "operation": "create_proof",
            "key": "dpop/dpop-keypair-es256.json",
            "htm": "POST",
            "htu": "https://server.example.com/token"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token"
              }
            }
          }
        },
        {
          "name": "rs256",
          "input": {
            "operation": "create_proof",
            "key": "dpop/dpop-keypair-rs256.json",
            "htm": "POST",
            "htu": "https://server.example.com/token"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "RS256",
                "jwk": {
                  "kty": "RSA",
                  "n": "qlDNavxW9K2dDzQ7v4dLrQ3DO1-A3KKA7OHUliGxi0pN86k0CDDzKkAIpu_sXuouMOhHrywBr3P2S4NJlznKdXHg1DZSNl5b6rXhikNgsTXQX0tYp1SVgZDIJ5_3lCg-pRuJuW8LRd1mlJITRfa8yyACRjFBohYPJ6h_WRvprugQaMXZmFlID9bYayorqnDpUtGPcDORLTzS7rSTfK0khmQ9R-FaVtcaMjM4bRAWknf-RPbv5rqTLkZRf8HnWtQ4JmK7LFMzHNG_0TP0nSgHEjrdtZo-nkirCfThlGGrlfbikJ1DR6e3FEz60eUCwYrsj-E5CgUYOMzL3WLvcIBdWw",
                  "e": "AQAB"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token"
              }
            }
          }
        },
        {
          "name": "htu-drops-query-and-fragment",
          "input": {
            "operation": "create_proof",
            "key": "dpop/dpop-keypair-es256.json",
            "htm": "POST",
            "htu": "https://server.example.com/token?a=b#frag"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token"
              }
            }
          }
        }
      ]
    },
    {
      "id": "DPOP-002",
      "title": "Include the DPoP proof in the token request header without an ath claim",
      "given": "A DPoP proof JWT generated for a token request",
      "when": "The token request is constructed",
      "then": "The proof is carried in the DPoP HTTP request header (not in Authorization), and its payload contains no ath claim because token-request proofs do not bind to an access token",
      "references": [
        "RFC 9449 §5",
        "RFC 9449 §4.2"
      ],
      "vectors": [
        {
          "name": "token-request",
          "input": {
            "operation": "token_request",
            "key": "dpop/dpop-keypair-es256.json",
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb"
          },
          "http": {
            "/token": {
              "status": 200,
              "body_fixture": "dpop/dpop-token-response.json"
            }
          },
          "expect_request": {
            "path": "/token",
            "method": "POST",
            "headers": {
              "authorization": "Basic Y2lkOnNlY3JldA==",
              "content-type": "application/x-www-form-urlencoded"
            },
            "form": {
              "grant_type": "authorization_code",
              "code": "SplxlOBeZQQYbYS6WxSbIA"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token"
              }
            }
          }
        }
      ]
    },
    {
      "id": "DPOP-003",
      "title": "Generate a resource-request proof carrying the ath claim",
      "given": "A DPoP key pair and a DPoP-bound access token",
      "when": "A DPoP proof JWT is generated for a protected-resource request",
      "then": "The proof payload contains an ath claim whose value equals BASE64URL(SHA-256(access_token)) with no base64 padding, matching the deterministic access_token/ath pairs in dpop-ath-pairs.json",
      "references": [
        "RFC 9449 §7",
        "RFC 9449 §4.2"
      ],
      "vectors": [
        {
          "name": "ath-pairs",
          "input": {
            "operation": "ath",
            "pairs": "dpop/dpop-ath-pairs.json"
          },
          "expect": {
            "outcome": "accept"
          }
        },
        {
          "name": "resource-proof",
          "input": {
            "operation": "create_proof",
            "key": "dpop/dpop-keypair-es256.json",
            "htm": "GET",
            "htu": "https://resource.example.com/protectedresource",
            "access_token": "example-dpop-bound-access-token-value"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "GET",
                "htu": "https://resource.example.com/protectedresource",
                "ath": "yRhCjMZbSgJuej6MpSmViNnUiiuiK_CT3FHQXkjq7vk"
              }
            }
          }
        }
      ]
    },
    {
      "id": "DPOP-004",
      "title": "Handle a use_dpop_nonce error and retry with the server nonce",
      "given": "A token or resource request that receives HTTP 401 with error=use_dpop_nonce and a DPoP-Nonce response header",
      "when": "The client automatically retries the request",
      "then": "The retried DPoP proof includes the server-provided nonce in its nonce claim, and the nonce is cached and pre-included in subsequent proofs sent to the same server",
      "references": [
        "RFC 9449 §8"
      ],
      "vectors": [
        {
          "name": "retry-with-nonce",
          "input": {
            "operation": "token_request",
            "key": "dpop/dpop-keypair-es256.json",
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb",
            "requests": 1
          },
          "http_sequence": {
            "/token": [
              {
                "status": 401,
                "headers": {
                  "WWW-Authenticate": "DPoP error=\"use_dpop_nonce\", error_description=\"Authorization server requires nonce in DPoP proof\"",
                  "DPoP-Nonce": "eyJ7S_zG.eyJH0-Z.HX4w-7v"
                },
                "body_fixture": "dpop/dpop-nonce-error-response.json"
              },
              {
                "status": 200,
                "body_fixture": "dpop/dpop-token-response.json"
              }
            ]
          },
          "expect_calls": {
            "/token": 2
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token",
                "nonce": "eyJ7S_zG.eyJH0-Z.HX4w-7v"
              }
            }
          }
        },
        {
          "name": "nonce-cached",
          "input": {
            "operation": "token_request",
            "key": "dpop/dpop-keypair-es256.json",
            "code": "SplxlOBeZQQYbYS6WxSbIA",
            "redirect_uri": "https://client.example.org/cb",
            "requests": 2
          },
          "http_sequence": {
            "/token": [
              {
                "status": 401,
                "headers": {
                  "WWW-Authenticate": "DPoP error=\"use_dpop_nonce\", error_description=\"Authorization server requires nonce in DPoP proof\"",
                  "DPoP-Nonce": "eyJ7S_zG.eyJH0-Z.HX4w-7v"
                },
                "body_fixture": "dpop/dpop-nonce-error-response.json"
              },
              {
                "status": 200,
                "body_fixture": "dpop/dpop-token-response.json"
              }
            ]
          },
          "expect_calls": {
            "/token": 3
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "POST",
                "htu": "https://server.example.com/token",
                "nonce": "eyJ7S_zG.eyJH0-Z.HX4w-7v"
              }
            }
          }
        }
      ]
    },
    {
      "id": "DPOP-005",
      "title": "Verify cnf.jkt in a bound token matches the DPoP key thumbprint",
      "given": "A DPoP-bound access token whose cnf claim carries a jkt field, and the DPoP key pair the token was bound to",
      "when": "The RFC 7638 SHA-256 JWK thumbprint of the DPoP public key is computed",
      "then": "The RFC 7638 thumbprint of each key-pair fixture equals its expected value, and the ES256 key's thumbprint equals the bound token's cnf.jkt value",
      "references": [
        "RFC 9449 §6",
        "RFC 7638 §3"
      ],
      "vectors": [
        {
          "name": "es256-bound-token",
          "input": {
            "operation": "thumbprint",
            "key": "dpop/dpop-keypair-es256.json",
            "bound_token": "dpop/dpop-bound-token.json"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "thumbprint": "x4bBYZ9vUTI9MboLfj1FuSMrI-sh5I8nTTPhZCHmDac"
            }
          }
        },
        {
          "name": "rs256",
          "input": {
            "operation": "thumbprint",
            "key": "dpop/dpop-keypair-rs256.json"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "thumbprint": "q-4W0RMOUTB77nG0mw9uiYg4LGsPBeQKdAuZVc9SGeM"
            }
          }
        }
      ]
    },
