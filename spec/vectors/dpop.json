    {
      "id": "DPOP-007",
      "title": "Generate ES256 and RS256 key pairs",
      "given": "A request to generate a DPoP key pair",
      "when": "The algorithm is ES256, and separately when it is RS256",
      "then": "ES256 yields a valid EC P-256 key pair and RS256 yields a valid RSA key pair with a modulus of at least 2048 bits; an unsupported algorithm is rejected with an error",
      "references": [
        "RFC 9449 §4.1",
        "RFC 7518 §3.1"
      ],
      "vectors": [
        {
          "name": "es256",
          "input": {
            "operation": "generate_key",
            "alg": "ES256"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "kty": "EC",
              "crv": "P-256"
            }
          }
        },
        {
          "name": "rs256",
          "input": {
            "operation": "generate_key",
            "alg": "RS256"
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "kty": "RSA",
              "min_modulus_bits": 2048
            }
          }
        },
        {
          "name": "unsupported",
          "input": {
            "operation": "generate_key",
            "alg": "HS256"
          },
          "expect": {
            "outcome": "reject",
            "error": "unsupported_algorithm"
          }
        }
      ]
    },
    {
      "id": "DPOP-008",
      "title": "DPoP-bound token uses the Authorization: DPoP scheme",
      "given": "A DPoP-bound access token (token_type DPoP)",
      "when": "A protected-resource request is constructed",
      "then": "The Authorization header uses the DPoP scheme (Authorization: DPoP <access_token>) rather than the Bearer scheme, and the accompanying DPoP proof header carries the ath claim",
      "references": [
        "RFC 9449 §7"
      ],
      "vectors": [
        {
          "name": "resource-request",
          "input": {
            "operation": "resource_request",
            "key": "dpop/dpop-keypair-es256.json",
            "access_token": "example-dpop-bound-access-token-value"
          },
          "http": {
            "/userinfo": {
              "status": 200,
              "body_fixture": "userinfo/standard-claims.json"
            }
          },
          "expect_request": {
            "path": "/userinfo",
            "method": "GET",
            "headers": {
              "authorization": "DPoP example-dpop-bound-access-token-value"
            }
          },
          "expect": {
            "outcome": "accept",
            "result": {
              "header": {
                "typ": "dpop+jwt",
                "alg": "ES256",
                "jwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "R1_cAR40t8_oOmoq64DJKyCn_wp_M-31Vxx1KavGTtg",
                  "y": "dkMh8R65lFQdtRvkgJ2Ebqp7IcAjS2xhCAUNAHyRaDI"
                }
              },
              "payload": {
                "htm": "GET",
                "htu": "https://server.example.com/userinfo",
                "ath": "yRhCjMZbSgJuej6MpSmViNnUiiuiK_CT3FHQXkjq7vk"
              }
            }
          }
        }
      ]
    }
